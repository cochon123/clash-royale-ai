[Unit]
Description=Clash Royale Arena
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=clasharena
Group=clasharena
WorkingDirectory=/opt/clash-arena/current
EnvironmentFile=/etc/clash-arena.env
ExecStart=/opt/clash-arena/venv/bin/python -m uvicorn webapps.arena.asgi:application --factory --host 127.0.0.1 --port 8800 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --limit-concurrency 64 --timeout-keep-alive 5 --no-access-log
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/clash-arena
UMask=0077
CPUQuota=150%
MemoryHigh=3500M
MemoryMax=4G
TasksMax=128
LimitNOFILE=4096
Environment=PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1

[Install]
WantedBy=multi-user.target
