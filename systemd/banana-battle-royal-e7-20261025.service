[Unit]
Description=Frozen Banana-1 / Banana-2 epoch 3 / Banana-2 epoch 7 round robin

[Service]
Type=simple
WorkingDirectory=%h/Documents/mini-project/clash-royale-ai
Environment=PYTHONPATH=%h/Documents/mini-project/clash-royale-ai/src:%h/Documents/mini-project/clash-royale-ai/engine
Environment=CR_SOURCE_ELF=%h/Documents/mini-project/clash-royale-ai/engine/analysis/libg-cipher/libg.decrypted.so
Environment=CR_TRIM_CHECKPOINT_JSON=1
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/Documents/mini-project/clash-royale-ai/.venv/bin/python -m rl.banana_tournament --run-dir engine/runs/banana-battle-royal-e7-20261025 --workers 4 --seeds 4 --seed-start 3824101000 --checkpoint banana-1=runs/banana-1/base.pt --checkpoint banana-2-e3=runs/banana-2/archive-epoch3/base.pt --checkpoint banana-2-e7=runs/banana-2/base.pt
