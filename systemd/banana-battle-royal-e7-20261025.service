KillMode=mixed
TimeoutStopSec=300
Nice=10
CPUQuota=400%
MemoryMax=5G
StandardOutput=append:%h/Documents/mini-project/clash-royale-ai/engine/runs/banana-battle-royal-e7-20261025/console.log
StandardError=append:%h/Documents/mini-project/clash-royale-ai/engine/runs/banana-battle-royal-e7-20261025/console.log
