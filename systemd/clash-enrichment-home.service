[Unit]
Description=Clash Royale native replay enrichment alignment run
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/projects/clash-royale-ai
Environment=PYTHONPATH=%h/projects/clash-royale-ai/src
Environment=CR_SOURCE_ELF=%h/projects/clash-royale-ai/engine/analysis/libg-cipher/libg.decrypted.so
Environment=CR_TRIM_CHECKPOINT_JSON=1
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/projects/clash-royale-ai/.venv/bin/python -m cr_replay_pipeline.native_enrichment --source data/native-enrichment-input --decks engine/data/fast_league_decks.json --audit-dir engine/runs/replay-enrichment-audit-20261024 --run-dir engine/runs/replay-enrichment-home-20261024 --binary engine/rust-engine/target/release/rust_league_rl --checkpoint engine/analysis/native-pipeline/oracle-export-01/stage01-attempt001/state --workers 2 --seeds 4
Restart=on-failure
RestartSec=20
Nice=10
CPUQuota=180%
MemoryMax=2300M
StandardOutput=append:%h/projects/clash-royale-ai/engine/runs/replay-enrichment-home-20261024/console.log
StandardError=append:%h/projects/clash-royale-ai/engine/runs/replay-enrichment-home-20261024/console.log

[Install]
WantedBy=default.target
