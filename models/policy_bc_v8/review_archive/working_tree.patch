+def clip_history_to_checkpoint(
+    history: list[dict[str, Any]], checkpoint: dict[str, Any]
+) -> list[dict[str, Any]]:
+    epoch = checkpoint.get("epoch")
+    if epoch is None:
+        return list(history)
+    last = int(epoch)
+    return [row for row in history if int(row.get("epoch") or 0) <= last]
